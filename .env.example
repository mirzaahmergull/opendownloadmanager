# Optional environment for "Default SDK credentials" cloud destinations.
# Open Download Manager does not read this file; export these variables in the
# shell, service or shortcut that launches the app. Stored (encrypted) keys
# configured in Settings -> Developer tools take precedence and need none of this.

# Cloudflare R2 (provider "Cloudflare R2"): an R2 API token with Object Read & Write.
# Used before the AWS default chain so AWS credentials are never sent to R2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_SESSION_TOKEN=

# Amazon S3 / S3-compatible (provider "Amazon S3 / compatible"): standard AWS chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# Google Cloud Storage: path to a service-account JSON key, or use
# `gcloud auth application-default login` instead.
# GOOGLE_APPLICATION_CREDENTIALS=
